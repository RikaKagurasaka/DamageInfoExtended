<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <PluginVersion>0.1.0.0</PluginVersion>
    <AssemblyName>DamageInfoExtended</AssemblyName>
    <Name>Damage Info Extended</Name>
    <Author>Rika Kagurasaka; derived from Damage Info by perchbird</Author>
    <Punchline>Add damage type, source, and calculated mitigation to native flytext.</Punchline>
    <Description>GPL-3.0 Damage Info derivative that annotates local incoming damage with calculated active mitigation.</Description>
    <RepoUrl>https://github.com/RikaKagurasaka/DamageInfoExtended</RepoUrl>
    <Tags>combat;damage;flytext;mitigation</Tags>
    <Changelog>Initial public testing build. Adds calculated local incoming-damage mitigation to Damage Info flytext, rounded to whole percentages.</Changelog>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  
  <PropertyGroup>
    <AssemblyTitle>DamageInfoExtended</AssemblyTitle>
    <Product>DamageInfoExtended</Product>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Version>$(PluginVersion)</Version>
    <FileVersion>$(PluginVersion)</FileVersion>
    <AssemblyVersion>$(PluginVersion)</AssemblyVersion>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugType>full</DebugType>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.0.1">
      <PrivateAssets>None</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ContentWithTargetPath Include="Data\positionals.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>positionals.csv</TargetPath>
    </ContentWithTargetPath>
  </ItemGroup>
</Project>
